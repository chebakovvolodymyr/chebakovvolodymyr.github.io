doctype html
html
  head
    meta(charset='UTF-8')
    title Maršrutai

    link(rel='stylesheet', href='./styles.css')
    link(rel='icon', type="image/x-icon", href='./images/favicon.ico')
  body
    main#content
        div.header
          img(src='images/Top_title_kayak.png', class='')
        img(src='images/map.svg', class='map')
        div.footer
          a(href='/bicycle', class='image-wrapper back-button')
            img(src='images/Pradzia_passive.png', class='image')
            img(src='images/Pradzia_active.png', class='active-image')
          div.languages
            a(href='/lt', class='language image-wrapper')
              img(src='images/LT_lang_passive.png', class='image')
              img(src='images/LT_lang_active.png', class='active-image')
            a(href='/en', class='language image-wrapper')
              img(src='images/EN_lang_passive.png', class='image')
              img(src='images/EN_lang_active.png', class='active-image')
          div.steps
            a(href='/map', class='image-wrapper')
              img(src='images/Place_passive.png', class='image')
              img(src='images/Place_active.png', class='active-image')
              img(src='images/Peshehod_passive.png', class='image')
              img(src='images/Peshehod_active.png', class='active-image')
            a(href='/bicycle', class='image-wrapper')
              img(src='images/Velo_passive.png', class='image')
              img(src='images/Velo_active.png', class='active-image')
            a(href='#', class='image-wrapper')
              img(src='images/Kayak_active_Big.png', class='image')
    script(src='./htmx.min.js')