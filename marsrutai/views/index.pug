- isEnglish = () => language === 'en';

doctype html
html
  head
    meta(charset='UTF-8')
    title Maršrutai

    link(rel='stylesheet', href='./styles.css')
    link(rel='icon', type="image/x-icon", href='./images/favicon.ico')
  body
    main#content
        a(href='/map', class='image-wrapper mesta')
            img(src='images/Mesta_2.svg', class='image')
            img(src='images/Mesta_1.svg', class='active-image')
        div.title Maršrutai
        a(href='/hike', class='image-wrapper')
            img(src='images/Pohod_2.svg', class='image')
            img(src='images/Pohod_1.svg', class='active-image')
        a(href='/bicycle', class='image-wrapper velik')
            img(src='images/velik_2.svg', class='image')
            img(src='images/velik_1.svg', class='active-image')
        a(href='/kayak', class='image-wrapper kayak')
            img(src='images/kayak_2.svg', class='image')
            img(src='images/kayak_1.svg', class='active-image')
            div.languages
                if isEnglish()
                    span(class='language image-wrapper')
                        img(src='images/LT_lang_active.png', class='image')
                    a(href='/en', class='language image-wrapper')
                        img(src='images/EN_lang_passive.png', class='image')
                        img(src='images/EN_lang_active.png', class='active-image')
                else 
                    a(href='/' class='language image-wrapper')
                        img(src='images/LT_lang_passive.png', class='image')
                        img(src='images/LT_lang_active.png', class='active-image')
                    span(class='language image-wrapper')
                        img(src='images/EN_lang_active.png', class='image')
    script(src='./htmx.min.js')
    script(src='./script.js')